# ── Stage 1 : Build ────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# Build args (passes par la CI). Bakes statiques par Vite.
ARG VITE_API_URL=http://localhost:8000
ARG VITE_SITE_URL=localhost

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SITE_URL=$VITE_SITE_URL

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps; else npm install --legacy-peer-deps; fi

COPY . .
RUN npm run build

# ── Stage 2 : Serve via Nginx ──────────────────────────────
# Version figée, jamais « nginx:alpine » : une image bâtie avant le
# correctif garde sa faille tant qu'on ne la rebâtit pas, et une étiquette
# flottante ne dit pas laquelle tourne. 1.30.7 corrige NGINX2Root
# (CVE-2026-123007) et neuf autres failles publiées le 18/11/2026.
# src/test/image.test.js refuse une version antérieure.
FROM nginx:1.30.7-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Entrypoint qui genere /version.js depuis $IMAGE_TAG a chaque demarrage
# du container — la version est lue depuis le .env du VPS, pas du build.
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 8080

# Docker voit un nginx bloqué, pas seulement arrêté (wget est dans l'image).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
ENTRYPOINT ["/docker-entrypoint.sh"]
