# API base URL — DOIT inclure /api/v1
# Local dev :
#   VITE_API_URL=http://localhost:3001/api/v1
# Prod :
#   VITE_API_URL=https://api-portfolio.wk-archi-o22a-15m-g1.fr/api/v1
VITE_API_URL=http://localhost:3001/api/v1

# Optionnel
VITE_SITE_URL=https://web-portfolio.wk-archi-o22a-15m-g1.fr

# Version affichee dans l'UI (footer, status bar, ligne PORTFOLIO_xxx du Hero).
# En PROD : lue par docker-entrypoint.sh depuis IMAGE_TAG dans le .env du VPS
#          puis injectee dans window.APP_VERSION via /version.js.
# En DEV  : fallback automatique sur "dev" — pas besoin de definir cette variable.
# IMAGE_TAG=prod-v1.0.19
